# Andrés Valerio · variables de entorno
# Copiar a .env (gitignored) o configurar en Netlify dashboard.

# Google Analytics 4 (formato G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Microsoft Clarity (formato xxxxxxxxxx)
PUBLIC_MICROSOFT_CLARITY_ID=

# Google Search Console verification meta tag
PUBLIC_GSC_VERIFICATION=

# WhatsApp Business number
PUBLIC_WHATSAPP=

# Email de contacto
PUBLIC_CONTACT_EMAIL=

# Avisos de Netlify Forms (netlify/functions/submission-created.mjs → API de Resend).
# Configurar en Netlify → Site configuration → Environment variables.
# Si falta RESEND_API_KEY, FORM_NOTIFY_TO o FORM_NOTIFY_FROM, el formulario
# se guarda igual y la función no envía nada (responde 200).
# RESEND_API_KEY: clave de la API de Resend (re_…).
# FORM_NOTIFY_TO: destinatarios, separados por comas.
# FORM_NOTIFY_BCC: copia oculta, opcional, separada por comas.
# FORM_NOTIFY_FROM: remitente verificado en Resend. Ej: Andrés Valerio <avisos@andresvalerio.com>
RESEND_API_KEY=
FORM_NOTIFY_TO=
FORM_NOTIFY_BCC=
FORM_NOTIFY_FROM=
