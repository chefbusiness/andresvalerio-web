---
/**
 * Plantilla de las landings de producto de la representación oficial
 * (Miselup y Timlup). Hermana de `ServiceLanding.astro`, pero con lo que un
 * SaaS pide y un servicio no: capturas del producto y tabla de planes en tres
 * monedas.
 *
 * CO-BRANDING: el fondo y la tipografía son de Andrés; el color del producto
 * entra por `--sb-brand` en filos, eyebrows y acentos. Ver la nota larga en
 * `SaasBanner.astro` — mismo sistema, misma razón.
 *
 * PRECIOS: € es la fuente de verdad (es lo que cobra Stripe en la web oficial).
 * US$ y RD$ se derivan de `TASAS` en `@data/saas` y se marcan SIEMPRE como
 * referencia — el cliente no paga aquí, así que prometer un importe local
 * exacto sería mentirle.
 *
 * CAPTURAS: un ítem sin `src` pinta un ESQUELETO etiquetado, nunca una imagen
 * rota. Mismo criterio que el carrusel de la landing de Miselup.
 */
import CtaFinal from '@components/CtaFinal.astro';
import SaasMark from '@components/SaasMark.astro';
import { aUSD, aDOP, TASAS, MESES_ANUAL, HUB, type Saas, type Captura } from '@data/saas';

export interface SaasData {
  meta_title: string;
  meta_description: string;
  hero: { eyebrow: string; h1: string; lead: string };
  intro: { h2: string; parrafos: string[] };
  para_quien: { title: string; desc: string }[];
  resuelve: { h2: string; intro: string; items: { title: string; desc: string }[] };
  implantacion: { h2: string; intro: string; pasos: { title: string; desc: string }[] };
  faq: { q: string; a: string }[];
  cta: { h2: string; text: string };
}

interface Props {
  saas: Saas;
  data: SaasData;
  capturas: Captura[];
  /** Slugs del blog con los que emparejar esta landing (guía → producto). */
  guias?: { label: string; href: string; desc: string }[];
  /** El otro SaaS, para el enlace cruzado del final. */
  hermano: { nombre: string; href: string; tagline: string; slug: 'miselup' | 'timlup' };
}

const { saas, data, capturas, guias = [], hermano } = Astro.props;

/** Solo las que tienen imagen son ampliables; el visor navega entre ELLAS. */
const ampliables = capturas.filter((c) => c.src);
const conCaptura = ampliables.length;
/** Posición de cada captura dentro de `ampliables`, para que el índice del
 *  botón case con el del visor aunque en medio haya esqueletos. */
const indiceVisor = new Map(ampliables.map((c, n) => [c, n]));
---

<div class="sl" style={`--sb-brand:${saas.brand}; --sb-ink:${saas.brandInk}; --sb-soft:${saas.brandSoft}`}>
  <!-- ── HERO ── -->
  <section class="sl-hero">
    <div class="container">
      <p class="sl-crumb font-mono rv">
        <a href="/consultoria/">Consultoría</a> &nbsp;/&nbsp;
        <a href={HUB}>Software de gestión</a> &nbsp;/&nbsp;
        <strong>{saas.nombre}</strong>
      </p>

      <div class="sl-hero__marca rv d1">
        <SaasMark saas={saas.slug as 'miselup' | 'timlup'} size={44} wordmark />
        <span class="sl-hero__sello">Distribuidor oficial en RD</span>
      </div>

      <h1 class="rv d2">{data.hero.h1}</h1>
      <p class="sl-lead rv d3">{data.hero.lead}</p>

      <div class="sl-hero__ctas rv d4">
        <a href="/contacto/" class="btn-primary">
          Hablar con Andrés <span aria-hidden="true">→</span>
        </a>
        <a href={saas.url} class="sl-hero__oficial" target="_blank" rel="noopener noreferrer">
          Ver {saas.nombre} oficial <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── INTRO ── -->
  <section class="section sl-intro">
    <div class="container sl-narrow">
      <div class="sec-head rv">
        <span class="eyebrow">{data.hero.eyebrow}</span>
        <h2>{data.intro.h2}</h2>
      </div>
      <div class="sl-prosa rv d1">
        {data.intro.parrafos.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ── PARA QUIÉN ── -->
  <section class="section sl-quien">
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow">Para quién</span>
        <h2>Si te ves aquí, esto es para ti</h2>
      </div>
      <div class="sl-quien__grid">
        {
          data.para_quien.map((q, i) => (
            <div class:list={['sl-quien__item', 'rv', `d${i + 1}`]}>
              <h3>{q.title}</h3>
              <p>{q.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── CAPTURAS ── -->
  <section class="section bg-teal sl-shots">
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow light">Por dentro</span>
        <h2>{saas.nombre} funcionando</h2>
        {
          conCaptura === 0 && (
            <p>
              Estoy preparando capturas del entorno real. Mientras tanto, puedes verlo
              en vivo en <a href={saas.url} target="_blank" rel="noopener noreferrer">{saas.nombre} oficial</a>.
            </p>
          )
        }
      </div>

      <div class="sl-shots__grid">
        {
          capturas.map((c, i) => (
            <figure class:list={['sl-shot', 'rv', `d${Math.min(i + 1, 4)}`, { 'sl-shot--vacia': !c.src }]}>
              {c.src ? (
                <button
                  type="button"
                  class="sl-shot__zoom"
                  data-shot={String(indiceVisor.get(c))}
                  aria-label={`Ampliar la captura: ${c.title}`}
                >
                  <img src={c.src} alt={c.alt ?? c.title} loading="lazy" decoding="async" width="1920" height="1177" />
                  <span class="sl-shot__lupa" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="7" />
                      <path d="M20 20l-3.2-3.2M11 8.5v5M8.5 11h5" />
                    </svg>
                    Ampliar
                  </span>
                </button>
              ) : (
                <div class="sl-shot__hueco" aria-hidden="true">
                  <SaasMark saas={saas.slug as 'miselup' | 'timlup'} size={30} />
                  <span>{c.title}</span>
                </div>
              )}
              <figcaption>
                <strong>{c.title}</strong>
                {c.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    {
      conCaptura > 0 && (
        <dialog class="sl-visor" aria-label="Captura ampliada">
          <div class="sl-visor__caja">
            <button type="button" class="sl-visor__x" data-cerrar aria-label="Cerrar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>

            <img class="sl-visor__img" src="" alt="" />

            <p class="sl-visor__pie">
              <strong data-visor-titulo />
              <span data-visor-pie />
            </p>

            <div class="sl-visor__nav">
              <button type="button" data-paso="-1" aria-label="Captura anterior">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
              </button>
              <span class="sl-visor__cuenta" data-visor-cuenta />
              <button type="button" data-paso="1" aria-label="Captura siguiente">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>
          </div>
        </dialog>
      )
    }

    <script
      type="application/json"
      class="sl-shots-datos"
      is:inline
      set:html={JSON.stringify(
        ampliables.map((c) => ({ src: c.src, alt: c.alt ?? c.title, t: c.title, p: c.caption })),
      )}
    />
  </section>

  <!-- ── QUÉ RESUELVE ── -->
  <section class="section sl-resuelve">
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow">Qué resuelve</span>
        <h2>{data.resuelve.h2}</h2>
        <p>{data.resuelve.intro}</p>
      </div>
      <div class="sl-resuelve__grid">
        {
          data.resuelve.items.map((it, i) => (
            <div class:list={['sl-res', 'rv', `d${Math.min(i + 1, 4)}`]}>
              <span class="sl-res__n font-mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{it.title}</h3>
              <p>{it.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── PLANES ── -->
  <section class="section bg-bone sl-planes" id="planes">
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow">Planes</span>
        <h2>Cuánto cuesta {saas.nombre}</h2>
        <p>
          Estos son los planes oficiales. <strong>La suscripción la contratas tú
          directamente en {saas.nombre}</strong>, no aquí: yo me ocupo de dejártelo
          funcionando y de formar a tu equipo.
        </p>
      </div>

      <div class="sl-planes__grid">
        {
          saas.planes.map((p, i) => (
            <article class:list={['sl-plan', 'rv', `d${Math.min(i + 1, 4)}`, { 'sl-plan--top': p.destacado }]}>
              {p.destacado && <span class="sl-plan__flag">El que recomiendo</span>}
              <h3>{p.nombre}</h3>

              <p class="sl-plan__precio">
                {p.eur === null ? (
                  <span class="sl-plan__medida">A medida</span>
                ) : p.eur === 0 ? (
                  <span class="sl-plan__eur">Gratis</span>
                ) : (
                  <>
                    <span class="sl-plan__eur">{p.eur} €</span>
                    <span class="sl-plan__ref">≈ {aUSD(p.eur)} US$ · {aDOP(p.eur)} RD$</span>
                  </>
                )}
                <span class="sl-plan__unidad">{p.unidad}</span>
              </p>

              <p class="sl-plan__resumen">{p.resumen}</p>
              <ul class="sl-plan__lista">
                {p.incluye.map((x) => <li>{x}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="sl-planes__nota rv">
        <p>{saas.notaPrecios}</p>
        <p>
          <strong>Sobre las cifras en dólares y pesos:</strong> son una referencia al
          cambio de {TASAS.fecha} ({TASAS.usd} US$ y {TASAS.dop} RD$ por euro). El
          cargo real lo hace {saas.nombre} <strong>en euros</strong> con tarjeta, así
          que lo que te aparezca en el estado de cuenta depende de la tasa de tu banco.
          Los precios no incluyen impuestos.
        </p>
        <p>
          Si pagas al año, pagas {MESES_ANUAL} meses y usas 12: dos meses libres.
        </p>
      </div>
    </div>
  </section>

  <!-- ── IMPLANTACIÓN (mi parte) ── -->
  <section class="section sl-implanta">
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow">Mi trabajo</span>
        <h2>{data.implantacion.h2}</h2>
        <p>{data.implantacion.intro}</p>
      </div>
      <div class="sl-implanta__grid">
        {
          data.implantacion.pasos.map((p, i) => (
            <div class:list={['sl-paso', 'rv', `d${i + 1}`]}>
              <span class="sl-paso__n font-mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="sl-implanta__presupuesto rv">
        La implantación se presupuesta según tu operación: cuántas recetas o locales
        hay que montar, y hasta dónde llega el acompañamiento.
        <a href="/contacto/">Cuéntame tu caso</a> y te paso una propuesta cerrada.
      </p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section sl-faq">
    <div class="container sl-narrow">
      <div class="sec-head rv">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Antes de que me escribas</h2>
      </div>
      {
        data.faq.map((f, i) => (
          <details class:list={['sl-q', 'rv', `d${Math.min(i + 1, 4)}`]}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ── SIGUIENTE PASO: hermano + guías ── -->
  <section class="section sl-otros">
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow">Seguir leyendo</span>
        <h2>Lo que suele venir después</h2>
      </div>
      <div class="sl-otros__grid">
        <a class="sl-otro sl-otro--saas rv d1" href={hermano.href}>
          <SaasMark saas={hermano.slug} size={28} wordmark />
          <p>{hermano.tagline}</p>
          <span class="sl-otro__mas">Ver {hermano.nombre} <span aria-hidden="true">→</span></span>
        </a>
        {
          guias.map((g, i) => (
            <a class:list={['sl-otro', 'rv', `d${i + 2}`]} href={g.href}>
              <h3>{g.label}</h3>
              <p>{g.desc}</p>
              <span class="sl-otro__mas">Leer <span aria-hidden="true">→</span></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaFinal title={data.cta.h2} text={data.cta.text} ctaLabel="Escribirme por WhatsApp" />
</div>

<style>
  /* ── Hero ── */
  .sl-hero {
    background:
      radial-gradient(ellipse at 15% 0%, color-mix(in srgb, var(--sb-brand) 26%, transparent), transparent 58%),
      linear-gradient(155deg, var(--teal) 0%, var(--footer-bg) 100%);
    color: var(--bone);
    padding-block: clamp(3.5rem, 9vw, 7rem);
    border-top: 2px solid var(--sb-brand);
  }
  .sl-crumb {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(243, 236, 221, 0.6);
    margin: 0 0 1.75rem;
  }
  .sl-crumb a {
    color: inherit;
  }
  .sl-hero__marca {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    color: var(--bone);
  }
  .sl-hero__sello {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    color: var(--brass);
    border: 1px solid color-mix(in srgb, var(--brass) 45%, transparent);
  }
  .sl-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.6vw, 4rem);
    line-height: 1.08;
    color: var(--bone);
    margin: 1.5rem 0 1.25rem;
    max-width: 20ch;
  }
  .sl-lead {
    font-size: clamp(1rem, 1.7vw, 1.1875rem);
    line-height: 1.7;
    color: rgba(243, 236, 221, 0.85);
    max-width: 58ch;
    margin: 0;
  }
  .sl-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.5rem;
  }
  .sl-hero__oficial {
    color: var(--bone);
    font-size: 0.9375rem;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--sb-brand) 70%, transparent);
    padding-bottom: 2px;
  }
  .sl-hero__oficial:hover {
    border-bottom-color: var(--bone);
  }

  /* ── Bloques comunes ── */
  .sl-narrow {
    max-width: 760px;
  }
  .sl-prosa p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--ink-soft);
    margin: 0 0 1.25rem;
  }
  .bg-teal {
    background: var(--teal);
    color: var(--bone);
  }
  .bg-bone {
    background: var(--bone);
  }
  .sl :global(.eyebrow.light) {
    color: var(--sb-brand);
  }
  .sl :global(.eyebrow.light)::before {
    background: var(--sb-brand);
  }

  /* ── Para quién ── */
  .sl-quien__grid,
  .sl-resuelve__grid,
  .sl-implanta__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
  .sl-quien__item h3,
  .sl-res h3,
  .sl-paso h3 {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }
  .sl-quien__item p,
  .sl-res p,
  .sl-paso p {
    font-size: 0.9688rem;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }
  .sl-quien__item {
    padding-top: 1rem;
    border-top: 2px solid var(--sb-brand);
  }
  .sl-res__n,
  .sl-paso__n {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--sb-ink);
    margin-bottom: 0.75rem;
  }

  /* ── Capturas ── */
  .sl-shots__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
  }
  .sl-shot {
    margin: 0;
  }
  .sl-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid rgba(243, 236, 221, 0.16);
    background: #fff;
  }

  /* ── Disparador de la galería ── */
  .sl-shot__zoom {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: 6px;
  }
  .sl-shot__zoom img {
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .sl-shot__zoom:hover img,
  .sl-shot__zoom:focus-visible img {
    transform: scale(1.012);
    border-color: var(--sb-brand);
  }
  .sl-shot__lupa {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: rgba(13, 42, 39, 0.82);
    color: var(--bone);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .sl-shot__lupa svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .sl-shot__zoom:hover .sl-shot__lupa,
  .sl-shot__zoom:focus-visible .sl-shot__lupa {
    opacity: 1;
    transform: translateY(0);
  }
  /* En táctil no hay hover: la pista se queda siempre visible. */
  @media (hover: none) {
    .sl-shot__lupa {
      opacity: 1;
      transform: none;
    }
  }

  /* ── Visor ── */
  .sl-visor {
    width: min(96vw, 1500px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .sl-visor::backdrop {
    background: rgba(7, 24, 22, 0.92);
    backdrop-filter: blur(3px);
  }
  .sl-visor__caja {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .sl-visor__img {
    display: block;
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 6px;
    background: #fff;
    border: 1px solid rgba(243, 236, 221, 0.2);
  }
  .sl-visor__pie {
    margin: 0;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(243, 236, 221, 0.78);
  }
  .sl-visor__pie strong {
    display: block;
    color: var(--bone);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }
  .sl-visor__x {
    position: absolute;
    top: -2.75rem;
    right: 0;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(243, 236, 221, 0.25);
    background: rgba(243, 236, 221, 0.08);
    color: var(--bone);
    cursor: pointer;
  }
  .sl-visor__x svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .sl-visor__x:hover {
    background: rgba(243, 236, 221, 0.18);
  }
  .sl-visor__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }
  .sl-visor__nav button {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(243, 236, 221, 0.25);
    background: rgba(243, 236, 221, 0.08);
    color: var(--bone);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .sl-visor__nav button svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .sl-visor__nav button:hover {
    background: var(--sb-brand);
    border-color: var(--sb-brand);
  }
  .sl-visor__cuenta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: rgba(243, 236, 221, 0.7);
    min-width: 3.5rem;
    text-align: center;
  }
  /* Con una sola captura no hay nada entre lo que navegar. */
  .sl-visor[data-unica] .sl-visor__nav {
    display: none;
  }

  @media (max-width: 640px) {
    .sl-visor__x {
      top: 0.5rem;
      right: 0.5rem;
      background: rgba(7, 24, 22, 0.75);
    }
