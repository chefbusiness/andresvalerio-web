<script>
  /**
   * Galería de capturas: abre la imagen a tamaño grande al hacer clic.
   *
   * Va sobre <dialog> a propósito — el navegador ya nos da gratis el foco
   * atrapado dentro, el cierre con Escape y el fondo inerte, que es justo lo
   * que suele salir mal cuando esto se escribe a mano.
   *
   * Los datos viajan en un <script type="application/json"> junto al visor y
   * NO en atributos de cada botón: los pies de foto llevan comillas y acentos,
   * y así no hay que escaparlos dos veces.
   */
  type Shot = { src: string; alt: string; t: string; p: string };

  function montarGaleria(seccion: HTMLElement) {
    const visor = seccion.querySelector<HTMLDialogElement>('.sl-visor');
    const datos = seccion.querySelector<HTMLScriptElement>('.sl-shots-datos');
    if (!visor || !datos) return;

    let shots: Shot[] = [];
    try {
      shots = JSON.parse(datos.textContent || '[]');
    } catch {
      return; // sin datos utilizables, la página se queda como estaba
    }
    if (!shots.length) return;

    const img = visor.querySelector<HTMLImageElement>('.sl-visor__img')!;
    const titulo = visor.querySelector<HTMLElement>('[data-visor-titulo]')!;
    const pie = visor.querySelector<HTMLElement>('[data-visor-pie]')!;
    const cuenta = visor.querySelector<HTMLElement>('[data-visor-cuenta]')!;
    if (shots.length < 2) visor.setAttribute('data-unica', '');

    let actual = 0;
    /** Quién abrió el visor, para devolverle el foco al cerrar. */
    let origen: HTMLElement | null = null;

    function pintar(i: number) {
      actual = (i + shots.length) % shots.length;
      const s = shots[actual];
      img.src = s.src;
      img.alt = s.alt;
      titulo.textContent = s.t;
      pie.textContent = s.p;
      cuenta.textContent = `${actual + 1} / ${shots.length}`;
    }

    seccion.querySelectorAll<HTMLButtonElement>('.sl-shot__zoom').forEach((btn) => {
      btn.addEventListener('click', () => {
        origen = btn;
        pintar(Number(btn.dataset.shot));
        visor.showModal();
      });
    });

    visor.querySelectorAll<HTMLButtonElement>('[data-paso]').forEach((btn) => {
      btn.addEventListener('click', () => pintar(actual + Number(btn.dataset.paso)));
    });
    visor.querySelector('[data-cerrar]')?.addEventListener('click', () => visor.close());

    // Clic fuera de la imagen = cerrar. El <dialog> ocupa toda la pantalla, así
    // que hay que mirar si el clic cayó dentro de la caja, no del elemento.
    visor.addEventListener('click', (e) => {
      const caja = visor.querySelector('.sl-visor__caja');
      if (caja && !caja.contains(e.target as Node)) visor.close();
    });

    visor.addEventListener('keydown', (e) => {
      if (shots.length < 2) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); pintar(actual + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); pintar(actual - 1); }
    });

    visor.addEventListener('close', () => {
      origen?.focus();
      origen = null;
    });
  }

  document.querySelectorAll<HTMLElement>('.sl-shots').forEach(montarGaleria);
</script>
