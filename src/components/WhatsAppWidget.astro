---
/**
 * Widget flotante de WhatsApp — portado de johnguerrero.es con tres cambios
 * de casa:
 *
 * 1. El mensaje NO va hardcodeado: sale de `@utils/contacto`, así que cada
 *    página manda su propia atribución («te escribo desde la página de
 *    mentoría»). Es la única medición de origen del lead que tiene el sitio.
 * 2. `z-index` por DEBAJO del drawer del menú (200/201) y del popup de Bestia
 *    Fire (1000), que son modales: si se abre uno, el widget se queda detrás
 *    en vez de flotar sobre el velo oscuro.
 * 3. Paleta y tipografía del sitio (`--paper`, `--ink`, `--font-body`).
 *
 * CSS puro, 0 JS.
 */
import { whatsappUrl, etiquetaOrigen } from '@utils/contacto';

/** El origen se resuelve en build: cada página estática lleva ya su mensaje. */
const origen = etiquetaOrigen(Astro.url.pathname);
const href = whatsappUrl(origen);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir a Andrés Valerio por WhatsApp"
  class="wa-widget"
>
  <span class="wa-tooltip">¿Tienes un restaurante y necesitas una mano? Escríbeme, te contesto yo mismo.</span>

  <span class="wa-pulse"></span>
  <span class="wa-pulse wa-pulse-2"></span>

  <span class="wa-avatar">
    <img
      src="/images/chef/andres-valerio-avatar.jpg"
      alt=""
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
    />
  </span>

  <span class="wa-badge">
    <svg viewBox="0 0 24 24" fill="white" width="16" height="16" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </span>
</a>

<style>
  .wa-widget {
    position: fixed;
    bottom: 24px;
    right: 24px;
    /* Por debajo del drawer (200/201) y del popup de Bestia Fire (1000). */
    z-index: 190;
    display: block;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  .wa-widget:hover {
    transform: scale(1.08);
  }

  /* Bocadillo */
  .wa-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(8px);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    white-space: normal;
    width: 226px;
    padding: 10px 14px;
    line-height: 1.45;
    border-radius: 10px;
    box-shadow: 0 4px 18px rgba(22, 36, 31, 0.16);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s, transform 0.3s;
  }
  .wa-tooltip::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border: 6px solid transparent;
    border-left-color: var(--paper);
  }
  .wa-widget:hover .wa-tooltip,
  .wa-widget:focus-visible .wa-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }
  /* En móvil no hay hover y el bocadillo taparía media pantalla. */
  @media (max-width: 639px) {
    .wa-tooltip {
      display: none;
    }
  }

  /* Anillos de pulso */
  .wa-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.25);
    animation: wa-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .wa-pulse-2 {
    animation-delay: 0.6s;
  }
  @keyframes wa-ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    75%,
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  /* Retrato */
  .wa-avatar {
    position: relative;
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 3px solid var(--paper);
    box-shadow: 0 4px 20px rgba(22, 36, 31, 0.22);
    overflow: hidden;
    background: var(--bone-2);
  }
  .wa-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Insignia */
  .wa-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 24px;
    height: 24px;
    background: #25d366;
    border-radius: 50%;
    border: 2px solid var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(37, 211, 102, 0.4);
  }
  .wa-badge svg {
    width: 13px;
    height: 13px;
  }

  @media (min-width: 640px) {
    .wa-avatar {
      width: 64px;
      height: 64px;
    }
    .wa-badge {
      width: 28px;
      height: 28px;
    }
    .wa-badge svg {
      width: 15px;
      height: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-pulse {
      animation: none;
      display: none;
    }
    .wa-widget,
    .wa-tooltip {
      transition: none;
    }
  }

  @media print {
    .wa-widget {
      display: none;
    }
  }
</style>
