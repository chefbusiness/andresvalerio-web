---
// Bloque de interenlazado hacia el blog. Existe porque el grafo interno era de
// un solo sentido: los posts enlazaban a los servicios y NADA volvía. La home y
// las seis landings de consultoría no enlazaban a ni una guía, así que las 11
// piezas colgaban únicamente de /blog/, y las más nuevas se quedaron en
// "Descubierta, sin indexar" (GSC, 2026-08-21).
//
// Uso: <GuiasRelacionadas slugs={['slug-1','slug-2']} title="..." />
// Los slugs son el id de la colección `blog` (el nombre del fichero sin .md).
// Un slug inexistente se descarta en silencio: nunca rompe el build.

import { getCollection } from 'astro:content';

interface Props {
  slugs: string[];
  eyebrow?: string;
  title?: string;
  lead?: string;
  tone?: 'bone' | 'teal';
}

const {
  slugs,
  eyebrow = 'Sigue leyendo',
  title = 'Guías del blog',
  lead,
  tone = 'bone',
} = Astro.props;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const guias = slugs
  .map((slug) => posts.find((p) => p.id === slug))
  .filter((p) => p !== undefined);
---

{guias.length > 0 && (
  <section class:list={['guias', 'section', tone === 'teal' && 'bg-teal']}>
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow">{eyebrow}</span>
        <h2>{title}</h2>
        {lead && <p>{lead}</p>}
      </div>
      <div class="guias-grid">
        {guias.map((g, i) => (
          <a href={`/blog/${g.id}/`} class:list={['guia-card', 'rv', `d${(i % 3) + 1}`]}>
            <span class="guia-cat font-mono">{g.data.category}</span>
            <h3>{g.data.title}</h3>
            <p>{g.data.description}</p>
            <span class="guia-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .guias-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .guias-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .guia-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 26px 52px;
    border: 1px solid var(--line-light);
    border-radius: 4px;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
  }

  .guia-card:hover {
    transform: translateY(-3px);
    border-color: var(--pers);
    box-shadow: 0 12px 30px rgba(22, 36, 31, 0.08);
  }

  .guia-cat {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pers-deep);
  }

  .guia-card h3 {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.1vw, 1.5rem);
    line-height: 1.18;
    margin: 0;
  }

  .guia-card p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .guia-arrow {
    position: absolute;
    left: 26px;
    bottom: 24px;
    font-size: 1.05rem;
    color: var(--pers);
    transition: transform 0.28s ease;
  }

  .guia-card:hover .guia-arrow { transform: translateX(5px); }

  /* Sobre fondo teal (bloques oscuros). global.css solo aclara h1/h2/h3:
     el eyebrow y el lead hay que aclararlos aquí o quedan ilegibles. */
  .bg-teal .eyebrow { color: var(--pers-on-dark); }
  .bg-teal .eyebrow::before { background: var(--pers-on-dark); }
  .bg-teal .sec-head p { color: var(--bone-soft); }

  .bg-teal .guia-card {
    background: rgba(243, 236, 221, 0.05);
    border-color: var(--line-dark);
    color: var(--bone);
  }

  .bg-teal .guia-card:hover { border-color: var(--pers-on-dark); box-shadow: none; }
  .bg-teal .guia-cat { color: var(--brass); }
  .bg-teal .guia-card p { color: var(--bone-soft); }
  .bg-teal .guia-arrow { color: var(--pers-on-dark); }
</style>
