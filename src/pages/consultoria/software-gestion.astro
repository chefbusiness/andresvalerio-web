---
/**
 * Hub de la representación oficial de Miselup y Timlup en República Dominicana.
 *
 * No es una landing de venta: el cliente NO contrata aquí (lo hace en la web
 * oficial de cada producto). Esta página existe para dar contexto, credibilidad
 * y derivar a las dos hijas y al contacto — que es donde se cierra, porque estas
 * suscripciones se cierran dentro de una consultoría, no por autoservicio.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import CtaFinal from '@components/CtaFinal.astro';
import SaasMark from '@components/SaasMark.astro';
import { breadcrumbSchema, faqSchema } from '@utils/schema';
import { SAAS, HUB, rutaSaas, aUSD, aDOP, usd, PAQUETE_MICRO, type Saas } from '@data/saas';
import data from '@data/saas/hub.json';

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Consultoría', path: '/consultoria/' },
  { name: 'Software de gestión', path: HUB },
];

/**
 * Precio de entrada de cada producto, para la tarjeta comparativa. Aquí ya no
 * hay planes gratuitos ni de entrada (ver `PLANES_MINIMOS` en `@data/saas`),
 * así que el mínimo publicado ES el suelo desde el que se implementa.
 */
const desde = (planes: (typeof SAAS)[number]['planes']) =>
  planes.filter((p) => p.eur && p.eur > 0).sort((a, b) => a.eur! - b.eur!)[0];

/** La banda más barata del baremo: el "desde" del servicio de Andrés, en US$. */
const implDesde = (s: Saas) =>
  Math.min(...s.implantacion.bandas.map((b) => b.total));
---

<BaseLayout
  title={data.meta_title}
  description={data.meta_description}
  image="/og/og-default.jpg"
  canonicalPath={HUB}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={breadcrumbSchema(migas)} />
    <script type="application/ld+json" is:inline set:html={faqSchema(data.faq)} />
  </Fragment>

  <!-- HERO -->
  <section class="sg-hero">
    <div class="container">
      <p class="crumb font-mono rv">
        <a href="/consultoria/">Consultoría</a> &nbsp;/&nbsp; <strong>Software de gestión</strong>
      </p>
      <span class="eyebrow rv d1">{data.hero.eyebrow}</span>
      <h1 class="rv d2">{data.hero.h1}</h1>
      <p class="sg-lead rv d3">{data.hero.lead}</p>

      <div class="sg-sellos rv d4">
        {
          SAAS.map((s) => (
            <a class="sg-sello" href={rutaSaas(s.slug)} style={`--sg-brand:${s.brand}`}>
              <SaasMark saas={s.slug as 'miselup' | 'timlup'} size={30} wordmark />
              <span class="sg-sello__tag">{s.tagline}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- INTRO: lo que el POS no cubre -->
  <section class="section sg-intro">
    <div class="container sg-intro__inner">
      <div class="sec-head rv">
        <span class="eyebrow">El hueco real</span>
        <h2>{data.intro.h2}</h2>
      </div>
      <div class="sg-prosa rv d1">
        {data.intro.parrafos.map((p: string) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- LAS DOS HERRAMIENTAS -->
  <section class="section bg-teal sg-productos">
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow light">Dos herramientas, dos problemas</span>
        <h2>Una para los números, otra para las tareas del día</h2>
      </div>

      <div class="sg-grid">
        {
          SAAS.map((s, i) => {
            const entrada = desde(s.planes);
            return (
              <article
                class:list={['sg-card', 'rv', `d${i + 1}`]}
                style={`--sg-brand:${s.brand}; --sg-soft:${s.brandSoft}`}
              >
                <header class="sg-card__head">
                  <SaasMark saas={s.slug as 'miselup' | 'timlup'} size={38} wordmark />
                </header>
                <p class="sg-card__tag">{s.tagline}</p>
                <p class="sg-card__gancho">{s.gancho}</p>

                <p class="sg-card__precio">
                  {entrada && (
                    <span class="sg-card__desde">
                      Suscripción desde <span class="sg-card__cifra">{entrada.eur} €</span>
                      <span class="sg-card__ref"> (≈ {aUSD(entrada.eur!)} US$ · {aDOP(entrada.eur!)} RD$)</span>
                    </span>
                  )}
                  <span class="sg-card__impl">
                    Implementación desde <span class="sg-card__cifra">{usd(implDesde(s))} US$</span>
                  </span>
                </p>

                <a class="sg-card__cta" href={rutaSaas(s.slug)}>
                  Ver {s.nombre} en RD <span aria-hidden="true">→</span>
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- POR QUÉ ESTAS DOS -->
  <section class="section sg-porque">
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow">Por qué estas</span>
        <h2>{data.por_que.h2}</h2>
      </div>
      <div class="sg-razones">
        {
          data.por_que.items.map((it: { title: string; desc: string }, i: number) => (
            <div class:list={['sg-razon', 'rv', `d${i + 1}`]}>
              <span class="sg-razon__n font-mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{it.title}</h3>
              <p>{it.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- QUÉ APORTA ANDRÉS -->
  <section class="section bg-bone sg-aporto">
    <div class="container">
      <div class="sec-head rv">
        <span class="eyebrow">Mi parte</span>
        <h2>{data.que_aporto.h2}</h2>
        <p>{data.que_aporto.intro}</p>
      </div>
      <div class="sg-pasos">
        {
          data.que_aporto.items.map((it: { title: string; desc: string }, i: number) => (
            <div class:list={['sg-paso', 'rv', `d${i + 1}`]}>
              <h3>{it.title}</h3>
              <p>{it.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="sg-nota rv">
        La suscripción la contratas tú directamente en la web de cada producto. Mi
        trabajo de implementación, migración y formación se cobra aparte, con
        <strong>tarifa por bandas en dólares</strong> según el tamaño de tu operación:
        está publicada en la página de <a href={rutaSaas('miselup')}>Miselup</a> y en la
        de <a href={rutaSaas('timlup')}>Timlup</a>. Si arrancas pequeño y quieres las
        dos, el paquete Micro cierra en <strong>{usd(PAQUETE_MICRO.total)} US$</strong>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section sg-faq">
    <div class="container sg-faq__inner">
      <div class="sec-head rv">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Lo que me preguntan siempre</h2>
      </div>
      {
        data.faq.map((f: { q: string; a: string }, i: number) => (
          <details class:list={['sg-q', 'rv', `d${Math.min(i + 1, 4)}`]}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <CtaFinal title={data.cta.h2} text={data.cta.text} ctaLabel="Escribirme por WhatsApp" />
</BaseLayout>

<style>
  .sg-hero {
    background: linear-gradient(155deg, var(--teal) 0%, var(--footer-bg) 100%);
    color: var(--bone);
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }
  .crumb {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(243, 236, 221, 0.65);
    margin: 0 0 1.5rem;
  }
  .crumb a {
    color: inherit;
  }
  .sg-hero :global(.eyebrow) {
    color: var(--pers-on-dark);
  }
  .sg-hero :global(.eyebrow)::before {
    background: var(--pers-on-dark);
  }
  .sg-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4.25rem);
    line-height: 1.06;
    color: var(--bone);
    margin: 1rem 0 1.25rem;
    max-width: 18ch;
  }
  .sg-lead {
    font-size: clamp(1rem, 1.7vw, 1.1875rem);
    line-height: 1.7;
    color: rgba(243, 236, 221, 0.85);
    max-width: 58ch;
    margin: 0;
  }

  .sg-sellos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }
  .sg-sello {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.125rem;
    border: 1px solid rgba(243, 236, 221, 0.18);
    border-radius: 999px;
    background: rgba(243, 236, 221, 0.06);
    color: var(--bone);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .sg-sello:hover {
    border-color: var(--sg-brand);
    background: rgba(243, 236, 221, 0.11);
  }
  .sg-sello__tag {
    font-size: 0.8125rem;
    color: rgba(243, 236, 221, 0.72);
  }

  .sg-intro__inner,
  .sg-faq__inner {
    max-width: 760px;
  }
  .sg-prosa p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--ink-soft);
    margin: 0 0 1.25rem;
  }

  /* ── Tarjetas de producto ── */
  .sg-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }
  .sg-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 2rem;
    border: 1px solid rgba(243, 236, 221, 0.14);
    border-radius: 6px;
    background: rgba(243, 236, 221, 0.05);
    overflow: hidden;
  }
  .sg-card::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 3px;
    background: var(--sg-brand);
  }
  .sg-card__head {
    color: var(--bone);
  }
  .sg-card__tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sg-brand);
    margin: 0;
  }
  .sg-card__gancho {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    line-height: 1.25;
    color: var(--bone);
    margin: 0;
  }
  .sg-card__precio {
    font-size: 0.875rem;
    color: rgba(243, 236, 221, 0.75);
    margin: 0;
  }
  .sg-card__desde,
  .sg-card__impl {
    display: block;
  }
  .sg-card__cifra {
    color: var(--brass);
    font-weight: 600;
  }
  .sg-card__ref {
    color: rgba(243, 236, 221, 0.5);
  }
  .sg-card__cta {
    margin-top: auto;
    padding-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--bone);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    align-self: flex-start;
    transition: border-color 0.2s, gap 0.2s;
  }
  .sg-card__cta:hover {
    border-bottom-color: var(--sg-brand);
    gap: 0.7rem;
  }

  /* ── Razones ── */
  .sg-razones,
  .sg-pasos {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .sg-razon__n {
    display: block;
    font-size: 0.75rem;
    color: var(--pers-deep);
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }
  .sg-razon h3,
  .sg-paso h3 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
    margin: 0 0 0.625rem;
  }
  .sg-razon p,
  .sg-paso p {
    font-size: 0.9688rem;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }

  .bg-teal {
    background: var(--teal);
    color: var(--bone);
  }
  .bg-bone {
    background: var(--bone);
  }
  .sg-paso h3 {
    padding-top: 1rem;
    border-top: 2px solid var(--brass);
  }
  .sg-nota {
    margin: 3rem auto 0;
    max-width: 60ch;
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  /* ── FAQ ── */
  .sg-q {
    border-bottom: 1px solid rgba(22, 36, 31, 0.14);
  }
  .sg-q summary {
    cursor: pointer;
    list-style: none;
    padding: 1.25rem 2rem 1.25rem 0;
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.35;
  }
  .sg-q summary::-webkit-details-marker {
    display: none;
  }
  .sg-q summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    color: var(--pers-deep);
    font-size: 1.25rem;
  }
  .sg-q[open] summary::after {
    content: '−';
  }
  .sg-q p {
    margin: 0 0 1.5rem;
    padding-right: 2rem;
    font-size: 0.9688rem;
    line-height: 1.75;
    color: var(--ink-soft);
  }
</style>

<script>
  import { initReveal } from '@utils/reveal';
  initReveal();
</script>
